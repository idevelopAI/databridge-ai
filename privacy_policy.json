{
  "version": 1,
  "default_schema": "public",
  "tables": {
    "allow": [
      "public.departments",
      "public.employees",
      "public.projects"
    ],
    "deny": []
  },
  "columns": {
    "allow": [],
    "deny": [],
    "mask": {
      "public.employees.salary": "salary"
    },
    "restricted_terms": {}
  },
  "masking": {
    "enabled": true,
    "auto_detect": true,
    "allow_aggregates": true,
    "minimum_aggregate_group_size": 2,
    "replacement": "***"
  },
  "question_deny_terms": [
    "password hash",
    "Passwort-Hash",
    "private notes",
    "private Notizen",
    "social security number",
    "social security numbers",
    "SSN",
    "Sozialversicherungsnummer",
    "Sozialversicherungsnummern"
  ]
}
