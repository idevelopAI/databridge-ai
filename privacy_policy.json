{
  "version": 1,
  "default_schema": "public",
  "tables": {
    "allow": [
      "public.departments",
      "public.employees",
      "public.projects"
    ],
    "deny": []
  },
  "columns": {
    "allow": [],
    "deny": [
      "public.employees.password_hash",
      "public.employees.private_notes",
      "public.employees.ssn"
    ],
    "mask": {
      "public.employees.salary": "salary"
    },
    "restricted_terms": {
      "public.employees.password_hash": ["password hash", "Passwort-Hash"],
      "public.employees.private_notes": ["private notes", "private Notizen"],
      "public.employees.ssn": [
        "social security number",
        "social security numbers",
        "SSN",
        "Sozialversicherungsnummer",
        "Sozialversicherungsnummern"
      ]
    }
  },
  "masking": {
    "enabled": true,
    "auto_detect": true,
    "allow_aggregates": true,
    "minimum_aggregate_group_size": 2,
    "replacement": "***"
  }
}
